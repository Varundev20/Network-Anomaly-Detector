# Optional settings, read from environment variables (defaults shown).
# PowerShell example:  $env:OLLAMA_MODEL = "qwen3:1.7b"; streamlit run frontend/app.py
# No secrets or API keys are needed.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=300
# Optional: folder with the full CICIDS2017 CSV files
NODE_SENTINEL_INPUT_DIR=../Input_csv
NODE_SENTINEL_DB_PATH=node_sentinel.db
NODE_SENTINEL_BURST_THRESHOLD=3000
NODE_SENTINEL_PORT_SPREAD_THRESHOLD=50
